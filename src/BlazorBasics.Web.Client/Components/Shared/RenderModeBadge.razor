<div class="rm-banner">
    @if (AssignedRenderMode is null)
    {
        <div class="rm-prefix">Render mode</div>
        <div class="rm-steps">
            <div class="rm-step current mode-static">
                <div class="rm-name">Static</div>
                <div class="rm-sub">never interactive</div>
            </div>
        </div>
    }
    else
    {
        <div class="rm-prefix">Render path</div>
        <div class="rm-steps">
            @for (var i = 0; i < Path.Count; i++)
            {
                var step = Path[i];
                var isCurrent = i == Path.Count - 1;
                @if (i > 0)
                {
                    <div class="rm-arrow">→</div>
                }
                <div class="rm-step @(isCurrent ? "current" : "prior") mode-@(step.ToLowerInvariant())">
                    <div class="rm-name">@step</div>
                </div>
            }
        </div>
        <div class="rm-suffix">
            <span class="rm-suffix-label">assigned</span>
            <span class="rm-suffix-value">@AssignedRenderMode.GetType().Name.Replace("RenderMode", "")</span>
        </div>
    }
</div>

@code {
    private List<string> Path { get; set; } = new();

    protected override void OnInitialized()
    {
        if (AssignedRenderMode is not null)
        {
            Path.Add("Static");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (AssignedRenderMode is null) return;
        var current = RendererInfo.Name;
        if (Path[^1] != current)
        {
            Path.Add(current);
            StateHasChanged();
        }
    }
}
