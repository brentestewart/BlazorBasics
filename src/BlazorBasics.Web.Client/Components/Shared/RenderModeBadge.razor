<div class="rm-banner">
    <div class="rm-header">
        <div class="rm-title">Render path</div>
        @if (AssignedRenderMode is not null)
        {
            <div class="rm-assigned">
                <span class="rm-assigned-label">assigned</span>
                <span class="rm-assigned-value">@AssignedRenderMode.GetType().Name.Replace("RenderMode", "")</span>
            </div>
        }
        else
        {
            <div class="rm-assigned">
                <span class="rm-assigned-label">no @@rendermode</span>
                <span class="rm-assigned-value">(static only)</span>
            </div>
        }
    </div>
    <ol class="rm-timeline">
        @if (Path is not null)
        {
            @for (var i = 0; i < Path.Count; i++)
            {
                var step = Path[i];
                var isCurrent = i == Path.Count - 1;
                <li class="rm-step @(isCurrent ? "current" : "prior") mode-@(step.Mode.ToLowerInvariant())">
                    @if (isCurrent)
                    {
                        <span class="rm-time rm-time-current">current</span>
                    }
                    else
                    {
                        <span class="rm-time">+@FormatElapsed(Path[i + 1].At)</span>
                    }
                    <span class="rm-dot"></span>
                    <span class="rm-name">@step.Mode</span>
                </li>
            }
        }
    </ol>
</div>

@code {
    public record PathStep(string Mode, TimeSpan At);

    [PersistentState(AllowUpdates = true)]
    public List<PathStep>? Path { get; set; }

    [PersistentState(AllowUpdates = true)]
    public DateTime StartedUtc { get; set; }

    protected override void OnInitialized()
    {
        if (StartedUtc == default)
        {
            StartedUtc = DateTime.UtcNow;
        }
        Path ??= new();
        Record(RendererInfo.Name);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Record(RendererInfo.Name);
    }

    private void Record(string mode)
    {
        if (Path is null) return;
        if (Path.Count == 0 || Path[^1].Mode != mode)
        {
            var elapsed = DateTime.UtcNow - StartedUtc;
            Path.Add(new PathStep(mode, elapsed));
            StateHasChanged();
        }
    }

    private static string FormatElapsed(TimeSpan elapsed)
    {
        if (elapsed.TotalMilliseconds < 1) return "0ms";
        if (elapsed.TotalSeconds < 1) return $"{elapsed.TotalMilliseconds:F0}ms";
        return $"{elapsed.TotalSeconds:F3}s";
    }
}
