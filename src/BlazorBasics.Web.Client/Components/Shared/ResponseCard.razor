<div class="response-card">
    <header class="response-card-header">
        <strong>@Response.LlmName</strong>
        <span class="response-rating">Rated @Response.Rating / 10</span>
    </header>
    <p class="response-text">@Response.Text</p>
</div>

@code {
    [Parameter, EditorRequired]
    public required ComparisonResponse Response { get; set; }
}
