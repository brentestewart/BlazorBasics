@page "/lifecycle"
@page "/lifecycle/{filter}"
@rendermode InteractiveWebAssembly
@implements IDisposable

<PageTitle>Lifecycle</PageTitle>

<h1>Component lifecycle</h1>

<nav class="lc-filter">
    <NavLink class="lc-filter-link" href="/lifecycle" Match="NavLinkMatch.All">All</NavLink>
    <NavLink class="lc-filter-link" href="/lifecycle/sync">Sync only</NavLink>
    <NavLink class="lc-filter-link" href="/lifecycle/async">Async only</NavLink>
</nav>

<button class="lc-btn" @onclick="Rerender">Click to trigger a re-render (@clicks)</button>

<ol class="lc-log">
    @foreach (var entry in log)
    {
        <li>
            <span class="lc-name">@entry.Name</span>
            <span class="lc-time">+@entry.Ms ms</span>
        </li>
    }
</ol>

@code {
    [Parameter] public string? Filter { get; set; }

    private readonly List<LogEntry> log = new();
    private DateTime start = DateTime.Now;
    private int clicks;
    private bool capturing = true;
    private string? trackedFilter;

    private record LogEntry(string Name, int Ms);

    private void Add(string name, bool isAsync = false)
    {
        // If the route parameter changed via navigation, reset for a fresh capture.
        if (trackedFilter is not null && Filter != trackedFilter)
        {
            log.Clear();
            start = DateTime.Now;
            capturing = true;
        }
        trackedFilter = Filter;

        if (!capturing) return;
        if (Filter == "sync" && isAsync) return;
        if (Filter == "async" && !isAsync) return;

        log.Add(new LogEntry(name, (int)(DateTime.Now - start).TotalMilliseconds));
    }

    private void Rerender()
    {
        log.Clear();
        start = DateTime.Now;
        clicks++;
        capturing = true;
    }

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        Add("SetParametersAsync", isAsync: true);
        await base.SetParametersAsync(parameters);
    }

    protected override void OnInitialized() => Add("OnInitialized");

    protected override async Task OnInitializedAsync()
    {
        Add("OnInitializedAsync", isAsync: true);
        await Task.Yield();
    }

    protected override void OnParametersSet() => Add("OnParametersSet");

    protected override async Task OnParametersSetAsync()
    {
        Add("OnParametersSetAsync", isAsync: true);
        await Task.Yield();
    }

    protected override bool ShouldRender()
    {
        Add("ShouldRender");
        return true;
    }

    protected override void OnAfterRender(bool firstRender) =>
        Add($"OnAfterRender (firstRender={firstRender})");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Add($"OnAfterRenderAsync (firstRender={firstRender})", isAsync: true);
        await Task.Yield();
        if (capturing)
        {
            capturing = false;
            StateHasChanged();
        }
    }

    public void Dispose() => Console.WriteLine($"Dispose +{(int)(DateTime.Now - start).TotalMilliseconds}ms (navigate away to see)");
}
