@page "/comparison/{Id:int}"
@rendermode InteractiveAuto
@inject IComparisonService ComparisonService

<PageTitle>Comparison #@Id</PageTitle>

<section class="comparison-detail">
    @if (Comparison is null)
    {
        <p>Loading...</p>
    }
    else
    {
        <h2>@Comparison.Prompt</h2>
        <p class="meta">
            Category: <strong>@Comparison.Category</strong> ·
            Submitted by <strong>@Comparison.Submitter.Name</strong>
        </p>

        @if (Comparison.Responses.Count == 0)
        {
            <p><em>No responses yet.</em></p>
        }
        else
        {
            @foreach (var response in Comparison.Responses)
            {
                <ResponseCard Response="response" />
            }
        }
    }
</section>

<RenderModeBadge />

@code {
    [Parameter]
    public int Id { get; set; }

    private Comparison? Comparison { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Comparison = await ComparisonService.GetAsync(Id);
    }
}
