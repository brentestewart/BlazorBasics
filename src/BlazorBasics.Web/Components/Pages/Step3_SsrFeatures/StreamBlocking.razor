@page "/stream-blocking"

<PageTitle>Stream rendering (blocking)</PageTitle>

<section class="stream-demo">
    <div class="mode-banner">
        <span class="mode-tag">BLOCKING</span>
        <span class="mode-desc">Server waits for everything before sending any HTML</span>
    </div>

    <h1>Without <code>[StreamRendering]</code></h1>
    <p>
        Same component as the streamed page, no attribute. Expect a blank tab
        for ~3 seconds, then everything appears at once.
    </p>

    <a class="toggle-link" href="/stream">
        → switch to the STREAMING version
    </a>

    <StreamSections />
</section>
