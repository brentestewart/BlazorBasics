@page "/submit"
@inject IComparisonService ComparisonService
@inject NavigationManager Nav

<PageTitle>Submit a comparison</PageTitle>

<section class="submit-form">
    <h2>Submit a comparison</h2>

    <EditForm Model="Model!" OnValidSubmit="HandleSubmit" FormName="comparison-form">
        <DataAnnotationsValidator />

        <div class="form-row">
            <label>
                Prompt
                <InputText @bind-Value="Model!.Prompt" />
            </label>
            <ValidationMessage For="@(() => Model!.Prompt)" />
        </div>

        <div class="form-row">
            <label>
                Category
                <InputSelect @bind-Value="Model!.Category">
                    <option value="">Pick one...</option>
                    <option value="Coding">Coding</option>
                    <option value="Writing">Writing</option>
                    <option value="Math">Math</option>
                    <option value="Reasoning">Reasoning</option>
                </InputSelect>
            </label>
            <ValidationMessage For="@(() => Model!.Category)" />
        </div>

        <fieldset class="form-fieldset">
            <legend>Submitter</legend>

            <div class="form-row">
                <label>
                    Name
                    <InputText @bind-Value="Model!.Submitter.Name" />
                </label>
                <ValidationMessage For="@(() => Model!.Submitter.Name)" />
            </div>

            <div class="form-row">
                <label>
                    Email
                    <InputText @bind-Value="Model!.Submitter.Email" />
                </label>
                <ValidationMessage For="@(() => Model!.Submitter.Email)" />
            </div>

            <div class="form-row">
                <label>
                    Favorite LLM (optional)
                    <InputText @bind-Value="Model!.Submitter.FavoriteLlm" />
                </label>
            </div>
        </fieldset>

        <button type="submit" class="submit-btn">Submit</button>
    </EditForm>
</section>

<RenderModeBadge />

@code {
    [SupplyParameterFromForm]
    public Comparison? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private async Task HandleSubmit()
    {
        var saved = await ComparisonService.SubmitAsync(Model!);
        Nav.NavigateTo($"/comparison/{saved.Id}");
    }
}
