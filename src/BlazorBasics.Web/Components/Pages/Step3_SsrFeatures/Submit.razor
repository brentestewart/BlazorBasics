@page "/submit"
@inject NavigationManager Nav

<PageTitle>Submit personal info</PageTitle>

<section class="submit-form">
    <h2>Personal info</h2>

    @if (!string.IsNullOrEmpty(Name))
    {
        <div class="thanks">
            <h3>Thanks, @Name!</h3>
            <p>Your information has been submitted.</p>
            <a class="reset-link" href="/submit">Submit another</a>
        </div>
    }
    else
    {
        <EditForm EditContext="editContext" OnValidSubmit="HandleSubmit" FormName="personal-info-form">
            <DataAnnotationsValidator />

            <div class="form-row">
                <label>
                    First name
                    <InputText @bind-Value="Model!.FirstName" />
                </label>
                <ValidationMessage For="@(() => Model!.FirstName)" />
            </div>

            <div class="form-row">
                <label>
                    Last name
                    <InputText @bind-Value="Model!.LastName" />
                </label>
                <ValidationMessage For="@(() => Model!.LastName)" />
            </div>

            <div class="form-row">
                <label>
                    Email
                    <InputText @bind-Value="Model!.Email" />
                </label>
                <ValidationMessage For="@(() => Model!.Email)" />
            </div>

            <div class="form-row">
                <label>
                    Date of birth
                    <InputDate @bind-Value="Model!.DateOfBirth" />
                </label>
                <ValidationMessage For="@(() => Model!.DateOfBirth)" />
            </div>

            <div class="form-row">
                <label>
                    Country
                    <InputSelect @bind-Value="Model!.Country">
                        <option value="">Pick one...</option>
                        <option value="US">United States</option>
                        <option value="CA">Canada</option>
                        <option value="UK">United Kingdom</option>
                        <option value="DE">Germany</option>
                        <option value="Other">Other</option>
                    </InputSelect>
                </label>
                <ValidationMessage For="@(() => Model!.Country)" />
            </div>

            <div class="form-row">
                <label>
                    About you (optional)
                    <InputTextArea @bind-Value="Model!.AboutYou" rows="3" />
                </label>
            </div>

            <div class="form-row checkbox-row">
                <label>
                    <InputCheckbox @bind-Value="Model!.SubscribeToNewsletter" />
                    Subscribe to newsletter
                </label>
            </div>

            <ValidationSummary />

            <button type="submit" class="submit-btn">Submit</button>
        </EditForm>
    }
</section>

@code {
    [SupplyParameterFromForm]
    public PersonalInfo? Model { get; set; }

    [SupplyParameterFromQuery]
    public string? Name { get; set; }

    private EditContext? editContext;
    private ValidationMessageStore? messages;

    protected override void OnInitialized()
    {
        Model ??= new();
        editContext = new EditContext(Model);
        messages = new ValidationMessageStore(editContext);
    }

    private void HandleSubmit()
    {
        messages!.Clear();

        if (Model!.DateOfBirth is { } dob)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var age = today.Year - dob.Year;
            if (dob > today.AddYears(-age)) age--;
            if (age < 18)
            {
                messages.Add(() => Model.DateOfBirth!, "You must be at least 18 years old.");
                editContext!.NotifyValidationStateChanged();
                return;
            }
        }

        Nav.NavigateTo($"/submit?name={Uri.EscapeDataString(Model.FirstName)}");
    }
}
