@for (var i = 0; i < sections.Length; i++)
{
    var idx = i;
    var label = labels[idx];
    var value = sections[idx];
    var loaded = value is not null;

    <article class="stream-section @(loaded ? "loaded" : "waiting")">
        <header class="section-head">
            <span class="status-icon"></span>
            <h2>Section @label</h2>
        </header>
        <p class="section-body">@(value ?? "waiting for data...")</p>
    </article>
}

@code {
    private readonly string[] labels = { "A", "B", "C" };
    private readonly string?[] sections = new string?[3];

    protected override async Task OnInitializedAsync()
    {
        var start = DateTime.Now;

        for (var i = 0; i < sections.Length; i++)
        {
            await Task.Delay(1000);
            sections[i] = $"Loaded at +{(DateTime.Now - start).TotalSeconds:F2}s";
            if (i < sections.Length - 1) StateHasChanged();
        }
    }
}
